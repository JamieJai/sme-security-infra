<group name="sme_security,">
  <rule id="100101" level="6">
    <if_sid>2501</if_sid>
    <field name="app">^core$</field>
    <field name="message" type="pcre2">^Login failed:</field>
    <description>Nextcloud login failure from $(remoteAddr) for $(user).</description>
    <mitre><id>T1110</id></mitre>
    <group>nextcloud,authentication_failed,</group>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>remoteAddr</same_field>
    <description>Multiple Nextcloud login failures from the same source.</description>
    <mitre><id>T1110</id></mitre>
    <group>nextcloud,authentication_failures,brute_force,</group>
  </rule>

  <rule id="100200" level="0">
    <decoded_as>sme-keycloak-event</decoded_as>
    <description>Keycloak event.</description>
    <group>keycloak,</group>
  </rule>

  <rule id="100201" level="6">
    <if_sid>100200</if_sid>
    <field name="event_type">^LOGIN_ERROR$</field>
    <description>Keycloak login failure from $(srcip): $(error).</description>
    <mitre><id>T1110</id></mitre>
    <group>keycloak,authentication_failed,</group>
  </rule>

  <rule id="100202" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100201</if_matched_sid>
    <same_source_ip />
    <description>Multiple Keycloak login failures from the same source.</description>
    <mitre><id>T1110</id></mitre>
    <group>keycloak,authentication_failures,brute_force,</group>
  </rule>

  <rule id="100301" level="10" frequency="5" timeframe="120">
    <if_matched_sid>9705</if_matched_sid>
    <same_source_ip />
    <description>Multiple Dovecot login failures from the same source.</description>
    <mitre><id>T1110</id></mitre>
    <group>mail,dovecot,authentication_failures,brute_force,</group>
  </rule>

  <rule id="100401" level="8">
    <if_sid>1002</if_sid>
    <match type="pcre2">Failed to bind to uuid.*NT_STATUS_LOGON_FAILURE</match>
    <description>Samba AD replication bind failed authentication.</description>
    <group>samba,active_directory,replication,authentication_failed,</group>
  </rule>
</group>
