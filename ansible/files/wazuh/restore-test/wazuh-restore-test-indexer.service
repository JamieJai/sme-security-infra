[Unit]
Description=Ephemeral isolated OpenSearch for Wazuh restore tests
After=network-online.target remote-fs.target
RequiresMountsFor=/mnt/wazuh-snapshot-replica

[Service]
Type=simple
User=wazuh-indexer
Group=wazuh-indexer
Environment=OPENSEARCH_HOME=/usr/share/wazuh-indexer
Environment=OPENSEARCH_PATH_CONF=/etc/wazuh-restore-test
Environment=OPENSEARCH_TMPDIR=/var/lib/wazuh-restore-test/tmp
WorkingDirectory=/usr/share/wazuh-indexer
ExecStart=/usr/share/wazuh-indexer/bin/opensearch
Restart=no
TimeoutStartSec=180
TimeoutStopSec=120
SuccessExitStatus=143
LimitNOFILE=65535
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/wazuh-restore-test /var/lib/wazuh-restore-test /var/log/wazuh-restore-test

[Install]
WantedBy=multi-user.target
