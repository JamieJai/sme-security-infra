[primary_dc]
dc01 ansible_host=192.168.0.20 ansible_user=sysadmin

[secondary_dc]
dc02 ansible_host=192.168.0.21 ansible_user=sysadmin

[active_dc]
dc02

[wazuh_server]
wazuh ansible_host=192.168.0.30 ansible_user=sysadmin

[iam_server]
keycloak ansible_host=192.168.0.60 ansible_user=sysadmin

[nextcloud_server]
nextcloud ansible_host=192.168.0.50 ansible_user=sysadmin

[storage_server]
storage01 ansible_host=192.168.0.70 ansible_user=sysadmin ansible_ssh_private_key_file=~/.ssh/id_ed25519_homelab

[mail_server]
mail01 ansible_host=192.168.0.80 ansible_user=sysadmin

[windows_management]
win-mgmt01 ansible_host=192.168.0.76 ansible_user=localadmin ansible_connection=ssh ansible_shell_type=powershell ansible_ssh_common_args='-o ServerAliveInterval=30'

[all:vars]
ansible_python_interpreter=/usr/bin/python3

[windows_endpoint_pilot]
odj-verify01 ansible_host=192.168.0.77 ansible_user=localadmin ansible_connection=ssh ansible_shell_type=powershell ansible_ssh_common_args='-o ServerAliveInterval=30'
